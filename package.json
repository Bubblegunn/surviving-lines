{
  "name": "surviving-lines",
  "version": "0.3.0",
  "description": "surviving-lines is a command-line tool that counts the lines of code each author still has in a git repository, using git blame, and shows them next to each author's share of commits.",
  "keywords": [
    "git",
    "git-blame",
    "blame",
    "git-fame",
    "git-fame-alternative",
    "lines-per-author",
    "lines-of-code",
    "code-ownership",
    "codeowners",
    "authorship",
    "contributors",
    "mailmap",
    "git-statistics",
    "developer-metrics",
    "surviving-lines",
    "cli",
    "npx",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Efe Genc",
  "homepage": "https://github.com/Bubblegunn/surviving-lines#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bubblegunn/surviving-lines.git"
  },
  "bugs": {
    "url": "https://github.com/Bubblegunn/surviving-lines/issues"
  },
  "type": "module",
  "bin": {
    "surviving-lines": "bin/surviving-lines.js",
    "git-surviving-lines": "bin/surviving-lines.js"
  },
  "files": [
    "bin",
    "schema",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"bin/**\" --test-coverage-lines=98 --test-coverage-branches=87 --test-coverage-functions=97",
    "lint": "node --check bin/surviving-lines.js",
    "release": "node scripts/release.mjs",
    "release-gate": "node scripts/release-gate.mjs",
    "compare": "node scripts/compare/run.mjs",
    "compare:fetch": "node scripts/compare/fetch.mjs",
    "test:differential": "node scripts/compare/differential.mjs"
  },
  "devDependencies": {
    "publint": "^0.3.24"
  }
}
