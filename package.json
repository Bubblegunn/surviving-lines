{
  "name": "surviving-lines",
  "version": "0.1.2",
  "description": "Measure who wrote the code that is still alive in a git ref, using a deterministic sample of files and git blame, next to plain commit share.",
  "type": "module",
  "bin": { "surviving-lines": "bin/surviving-lines.js" },
  "files": ["bin", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/surviving-lines.js"
  },
  "engines": { "node": ">=20" },
  "keywords": ["git", "blame", "authorship", "ownership", "code-review", "metrics"],
  "author": "Efe Genc",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Bubblegunn/surviving-lines.git" },
  "homepage": "https://github.com/Bubblegunn/surviving-lines#readme",
  "devDependencies": { "publint": "^0.3.24" }
}
