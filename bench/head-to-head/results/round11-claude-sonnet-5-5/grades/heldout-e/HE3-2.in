 - Bash: git ls-files 'src/*.rs' | wc -l && echo "--- total lines by author (blame, follows moves/copies)" && for f in $(git ls-files 'src/*'); do git blame -w -M -C -C --line-porcelain HEAD -- "$f" 2>/dev/null | grep '^author ' ; done | sort | uniq -c | sort -rn | head -15 && echo "--- commit counts + last active" && git log --no-merges --pretty='%an|%ad' --date=short -- src | awk -F'|' '{c[$1]++; if(!($1 in l)) l[$1]=$2} END{for(a in c) print c[a], a, "last:", l[a]}' | sort -rn | head -10
 - Bash: for d in $(git ls-files 'src/*' | awk -F/ '{ if (NF>2) print $1"/"$2; else print $0 }' | sort -u); do echo "== $d"; for f in $(git ls-files "$d" ); do git blame -w -M -C -C --line-porcelain HEAD -- "$f" 2>/dev/null | grep '^author '; done | sort | uniq -c | sort -rn | head -3; done
