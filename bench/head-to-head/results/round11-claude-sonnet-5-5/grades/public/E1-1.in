COMMANDS RUN:
 - Skill: {"skill": "tool:skill"}
 - Bash: git log --all --no-merges --pretty=format:"%an" | sort | uniq -c | sort -rn | head -15; echo ---; git log -1 --format=%cd; echo ---; git ls-files | grep -v node_modules | grep -E '\.(js|ts|mjs|cjs)$' | head -80
 - Bash: for f in $(git ls-files | grep -vE 'node_modules|package-lock'); do
 n=$(git log --all --no-merges --pretty=format:"%an" -- "$f" | sort | uniq -c | sort -rn)
 tot=$(echo "$n" | awk '{s+=$1} END{print s}'); u=$(echo "$n" | wc -l); top=$(echo "$n" | head -1 | sed 's/^ *//')
 echo "$f | contributors=$u commits=$tot | top: $top"; done
echo ---; git log --all --no-merges --since=90.days.ago --pretty=format:"%an %ad" --date=short | head; echo; git log --all --no-merges --pretty=format:"%an|%ad" --date=short | awk -F'|' '!s[$1]++' | head -5
echo ---; git blame --line-porcelain lib/index.js | grep '^author ' | sort | uniq -c | sort -rn
