for mode in plain ignore; do echo "-- $mode"; for f in $(git ls-files); do if [ $mode = ignore ]; then git blame -w --ignore-revs-file /tmp/ign.txt --line-porcelain HEAD -- "$f"; else git blame -w --line-porcelain HEAD -- "$f"; fi 2>&1 | grep -E '^[0-9a-f]{40} ' | cut -c1-7; done | sort | uniq -c | grep -E 'b2005d9|02afce3|5317ebe|62628c0'; done
