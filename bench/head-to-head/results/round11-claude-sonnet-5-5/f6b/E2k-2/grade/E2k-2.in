 - Bash: git show --stat --format='== %h %an %s' b2005d9 02afce3 5317ebe 62628c0 | head -60; echo; for r in b2005d9 02afce3 5317ebe; do echo "$r plain: $(git ls-files | while read f; do git blame -w --line-porcelain HEAD -- "$f" 2>/dev/null | grep -c "^${r}" ; done | paste -sd+ | bc)"; done
ign=$(mktemp); echo 62628c04a1b16306a0285b3e26645acfa1c21687 > $ign
for r in b2005d9 02afce3 5317ebe; do echo "$r ignoring-format: $(git ls-files | while read f; do git blame -w --ignore-revs-file $ign --line-porcelain HEAD -- "$f" 2>/dev/null | grep -c "^${r}" ; done | paste -sd+ | bc)"; done
