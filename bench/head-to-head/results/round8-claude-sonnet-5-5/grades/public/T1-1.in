 - Bash: for mode in raw ignore; do echo "== $mode"; for f in $(git ls-files | grep -v '^LICENSE$'); do if [ $mode = ignore ]; then git blame -w -M -C --ignore-rev 62628c0 --line-porcelain -- $f; else git blame --line-porcelain -- $f; fi | grep '^author ' ; done | sort | uniq -c | sort -rn | head -12; done; echo; echo "== by file (ignore-rev)"; for f in lib/index.js test/test.js test/vary.js test/error-response.js test/example-app.js HISTORY.md README.md package.json; do echo "-- $f"; git blame -w -M -C --ignore-rev 62628c0 --line-porcelain -- $f | grep '^author ' | sort | uniq -c | sort -rn | head -4; done
