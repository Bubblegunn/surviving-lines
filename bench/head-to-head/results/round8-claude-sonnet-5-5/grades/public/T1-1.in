 - Bash: for f in $(git ls-files | grep -E '\.(js)$'); do echo "== $f"; git blame -w -M -C --ignore-rev 62628c0 --line-porcelain HEAD -- $f | grep '^author ' | sort | uniq -c | sort -rn; done; echo "=== TOTAL"; for f in $(git ls-files | grep -E '\.js$'); do git blame -w -M -C --ignore-rev 62628c0 --line-porcelain HEAD -- $f | grep '^author '; done | sort | uniq -c | sort -rn; echo "=== lib vs test"; for d in lib test; do echo "-- $d"; for f in $(git ls-files $d | grep '\.js$'); do git blame -w -M -C --ignore-rev 62628c0 --line-porcelain HEAD -- $f | grep '^author '; done | sort | uniq -c | sort -rn | head -5; done; echo "=== last commit per author"; git log --format='%an|%ad' --date=short | awk -F'|'
