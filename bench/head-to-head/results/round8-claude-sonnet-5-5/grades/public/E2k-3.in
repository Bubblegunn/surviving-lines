git ls-files | grep -v '^\.git' | while read f; do git blame --ignore-rev 62628c0 --line-porcelain -- "$f" 2>/dev/null | awk -v f="$f" '/^[0-9a-f]{40} /{h=substr($1,1,7)} /^author /{print h"|"substr($0,8)}'; done | grep -E '^(b2005d9|02afce3|5317ebe)' | sort | uniq -c
