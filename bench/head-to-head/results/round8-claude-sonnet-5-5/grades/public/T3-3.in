 - Bash: git shortlog -sne --all | head -30; echo ---; git shortlog -sn --all | wc -l; ls -a | grep -i mailmap
 - Bash: git shortlog -sne --all | sed -E 's/^ *[0-9]+\t//' | awk -F' <' '{n=tolower($1); e=$2; sub(/@.*/,"",e); print n"\t"e"\t"$0}' | sort | awk -F'\t' '{c[$1]++; l[$1]=l[$1]"\n  "$3} END{for(k in c) if(c[k]>1) print k l[k]}'; echo ---; git shortlog -sne --all | sed -E 's/^ *[0-9]+\t//' | sed -E 's/.*<([^@]+)@.*/\1/' | sort | uniq -d; git shortlog -sne --all | tail -35
 - Bash: cat > .mailmap <<'EOF'
