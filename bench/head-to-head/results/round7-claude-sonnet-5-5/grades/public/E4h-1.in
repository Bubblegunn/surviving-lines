 - Bash: cd <home>/claude-kredi-runs/2026-10-22/r7/out-P/runs/E4h-base-1/repo; for c in 8277075 53405aa 739dc11 815c7c6 0c843f9 dd7f043 fcd2b56 f038e77 0176afa; do echo "== $c"; git show --stat --format='%an %s' $c | head -12; git show -w --shortstat --format= $c; done; git show --stat --format= 62628c0
