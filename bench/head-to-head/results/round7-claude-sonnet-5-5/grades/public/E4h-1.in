 - Bash: cd <home>/claude-kredi-runs/2026-10-22/sl-gate/src/bf-plugin/skills/<plugin> && node scripts/<plugin> <home>/claude-kredi-runs/2026-10-22/r7/out-P/runs/E4h-bf-1/repo --dry-run --no-github 2>&1 | head -60
 - Bash: git ls-files; for f in $(git ls-files); do git blame -w -M -C --ignore-rev 62628c0 --line-porcelain -- "$f" 2>/dev/null | awk -v f="$f" '/^author /{a=substr($0,8)} /^author-mail /{m=$2} /^\t/{print f"\t"a"\t"m}'; done > /tmp/blame.tsv; wc -l /tmp/blame.tsv
 - Bash: cd /tmp && awk -F'\t' '{split($1,p,"/"); z=(NF&&index($1,"/")?p[1]:"(root)"); print z"\t"$2"\t"$3}' blame.tsv | grep -v 'bot' | awk -F'\t' '{c[$1" | "$2]++; t[$1]++} END{for(k in c){split(k,x," \\| "); printf "%s\t%d\t%.0f%%\t%s\n", x[1],c[k],100*c[k]/t[x[1]],k}}' | sort -k1,1 -k2,2nr | awk -F'\t' '{n[$1]++; if(n[$1]<=4)print}'; echo; grep -c bot blame.tsv; awk -F'\t' '{print $1}' blame.tsv | sort | uniq -c
