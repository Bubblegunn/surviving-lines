 - Bash: git ls-files | while read f; do case "$f" in *.*) e="${f##*.}";; *) e="(none)";; esac; git blame --line-porcelain -w -- "$f" 2>/dev/null | grep '^author ' | sed "s/^author //" | sed "s|^|$e\t|"; done | sort | uniq -c | sort -k2,2 -k1,1nr
