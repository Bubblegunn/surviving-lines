done; echo ---; git log --all --no-merges --pretty=format:"%an|%ad" --date=short | awk -F'|' '!s[$1]++{print}' | head -8; echo ---; git log --no-merges --pretty=format:"%an|%ad" --date=short | awk -F'|' '{l[$1]=$2; if(!($1 in f))f[$1]=$2; f[$1]=$2} END{for(k in f)print k, "first:",f[k]}' | sort -k3 | head -5; echo; wc -l lib/index.js; grep -c . package.json
