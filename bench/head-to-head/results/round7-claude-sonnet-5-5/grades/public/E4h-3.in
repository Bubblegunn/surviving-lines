 - Bash: git log --format='%h %an <%ae> %s' | head -60; echo; git shortlog -sne HEAD | head -30; git ls-files
 - Bash: agg(){ for f in "$@"; do git blame -w -M -C --ignore-rev 62628c0 --line-porcelain HEAD -- "$f" | grep '^author ' | sed 's/^author //'; done | sort | uniq -c | sort -rn | awk '{t+=$1;a[NR]=$0} END{for(i=1;i<=NR&&i<=5;i++)print a[i]; print "total",t}'; }
for g in lib test .github; do echo "== $g"; agg $(git ls-files $g); done
echo "== root"; agg $(git ls-files | grep -v /)
for f in $(git ls-files | grep -v /); do echo "-- $f"; agg $f | head -3; done
