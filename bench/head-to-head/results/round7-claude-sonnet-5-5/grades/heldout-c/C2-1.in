import subprocess,sys,collections
def blame(rev,f,extra=()):
    out=subprocess.run(["git","blame","-w","-M","--line-porcelain",*extra,rev,"--",f],capture_output=True,text=True,check=True).stdout.split("\n")
    res=[];c=None;a=None
    for l in out:
        if l.startswith("\t"): res.append((c,a,l[1:].strip()))
        elif len(l)>40 and l[40]==" " and all(x in "0123456789abcdef" for x in l[:40]): c=l[:40]
        elif l.startswith("author "): a=l[7:]
    return res
