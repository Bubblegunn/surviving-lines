python3 -I - <<'E'
import collections
rows=[l.rstrip('\n').split('\t') for l in open('/tmp/blame.tsv')]
def agg(pred,label):
    c=collections.Counter(); files=collections.defaultdict(set)
    for f,a,n in rows:
        if pred(f): c[a]+=int(n); files[a].add(f)
    t=sum(c.values()); print(label,t)
    for a,n in c.most_common(12): print(f"  {a:50} {n:5} {100*n/t:5.1f}% files={len(files[a])}")
agg(lambda f:f.star
