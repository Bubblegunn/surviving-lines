awk -F'\t' '{split($1,p,"/"); d=(length(p)>1)?p[1]:"(root)"; print d"\t"$2"\t"$3}' /tmp/blame.tsv | sort | uniq -c | sort -k2,2 -k1,1nr | awk '{print}' | head -60
echo ---files; awk -F'\t' '{c[$1"\t"$2]++} END{for(k in c)print c[k]"\t"k}' /tmp/blame.tsv | sort -k2,2 -k1,1nr | head -60
