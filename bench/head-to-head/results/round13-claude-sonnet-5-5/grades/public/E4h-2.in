 - Bash: cat > /tmp/own.py <<'E'
import subprocess,collections,sys
fs=subprocess.check_output(["git","ls-files"],text=True).split()
c=collections.defaultdict(collections.Counter)
for f in fs:
    top=f.split("/")[0] if "/" in f else "(root)"
    o=subprocess.check_output(["git","blame","-w","-M","-C","--ignore-rev","62628c0","--line-porcelain","HEAD","--",f],text=True)
    for l in o.splitlines():
        if l.startswith("author "):
            a=l[7:]
            if "[bot]" in a: continue
            c[top][a]+=1
for t,k in c.items():
    s=sum(k.values()); print(t,s,[(a,n,round(100*n/s)) for a,n in k.most_common(4)])
E
python3 -I /tmp/own.py; git log --format='%an|%ae' | grep -iE 'efe|troy|doug|dha
