#!/bin/bash
# usage: scan.sh <repo> <ignore-rev-full>
cd "$1" || exit 1
REV="$2"
blame_group() {
  while IFS= read -r f; do
    git blame --line-porcelain --ignore-rev "$REV" HEAD -- "$f"
  done | awk '/^author-mail /{m=$2} /^author /{ $1=""; a=substr($0,2)} /^\t/{ print a" "m }'
}
