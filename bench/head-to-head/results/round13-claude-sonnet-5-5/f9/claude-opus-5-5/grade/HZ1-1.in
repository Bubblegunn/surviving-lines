 - Bash: for f in $(git ls-files '*.py'); do git blame -w -M -C -C --line-porcelain HEAD -- "$f" | sed -n 's/^author-mail //p' | sed "s|^|$f |"; done > /tmp/blame.txt; wc -l /tmp/blame.txt; awk '{print $2}' /tmp/blame.txt | sort | uniq -c | sort -rn | head -25; echo; for e in $(awk '{print $2}' /tmp/blame.txt | sort -u); do echo "$e: $(git log --format='%an' --author="${e//[<>]/}" | sort -u | tr '\n' ';')"; done
 - Bash: grep dana /tmp/blame.txt | awk '{print $1}' | sort | uniq -c | sort -rn; echo; git log --format='%h %ad %an <%ae> | %s' --date=short --author=dana --author=priya --stat | head -80; echo; wc -l $(git ls-files '*.py') | sort -rn | head
