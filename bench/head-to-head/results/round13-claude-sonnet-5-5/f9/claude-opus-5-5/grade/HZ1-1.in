echo "ALL non-vendored:"; awk '{print $2}' /tmp/blame2.txt | norm | sort | uniq -c | sort -rn | head -12; wc -l < /tmp/blame2.txt
echo "LIBRARY only (colorama/):"; grep '^colorama/' /tmp/blame2.txt | awk '{print $2}' | norm | sort | uniq -c | sort -rn | head -10
