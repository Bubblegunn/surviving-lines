from collections import Counter, defaultdict
alias={"alex94puchades":"Alejandro Caravaca Puchades"}
g=defaultdict(Counter)
for l in open("/tmp/blame.tsv",encoding="utf-8"):
    f,a,m=l.rstrip("\n").split("\t")
    if "[bot]" in a: continue
    a=alias.get(a,a)
    top=f.split("/")[0]+"/" if "/" in f else "(root)"
    g[top][a]+=1
    if top=="(root)": g[f][a]+=1
for k in sorted(g):
    c=g[k]; t=sum(c.values())
    print(f"{k:16} total={t:4} " + ", ".join(f"{a} {n} ({100*n/t:.1f}%)" for a,n in c.most_common(3)))
EOF
