 - Skill: {"skill": "tool:skill", "args": "Who owns the code that survives today (blame-based line ownership, not commit counts)"}
 - Bash: cat .git-blame-ignore-revs; git log --format='%h %an <%ae> %ad %s' --date=short | head -20; git log --oneline | wc -l; git ls-files | wc -l; git ls-files | head -50
