 - Bash: echo "emails with >1 name:"; git log --format='%aE|%aN' | sort -u | awk -F'|' '{c[tolower($1)]++; n[tolower($1)]=n[tolower($1)]" ["$2"]"} END{for(e in c) if(c[e]>1) print e, n[e]}'; echo "names with >1 email:"; git log --format='%aN|%aE' | sort -u | awk -F'|' '{c[tolower($1)]++; n[tolower($1)]=n[tolower($1)]" "$2} END{for(e in c) if(c[e]>1) print e":", n[e]}'; git log --format='%aN|%aE' | sort -u | grep -iE 'goode|troy|puchad|wilson|doug|church|gasc'
