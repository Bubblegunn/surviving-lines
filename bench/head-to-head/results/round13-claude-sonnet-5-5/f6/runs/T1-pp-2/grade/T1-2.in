 - Bash: for f in $(cat /tmp/files.txt); do git blame -w -M -C --ignore-rev 62628c0 --line-porcelain -- "$f" | grep '^author '; done | sort | uniq -c | sort -rn | awk '{t+=$1; c[NR]=$1; $1=""; n[NR]=$0} END{for(i=1;i<=6;i++) printf "%s %d %.1f%%\n", n[i], c[i], 100*c[i]/t; print "total", t}'
