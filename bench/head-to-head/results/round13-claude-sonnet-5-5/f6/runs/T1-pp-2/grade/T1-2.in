COMMANDS RUN:
 - Bash: git show --stat --format='%h %an %s' 62628c0 | tail -3; echo ---; git ls-files | grep -Ev '(^|/)(package-lock\.json|node_modules)/?' > /tmp/files.txt; wc -l < /tmp/files.txt
run() { while read f; do git blame -w -M -C --line-porcelain $1 -- "$f" 2>/dev/null | grep '^author ' ; done < /tmp/files.txt | sort | uniq -c | sort -rn | head -15; }
echo "== ignoring reformat commit =="; run "--ignore-rev 62628c0"
echo "== plain =="; run ""
 - Bash: git --version; git blame -w -M -C --ignore-rev 62628c0 --line-porcelain -- index.js 2>&1 | head -3; git log --format='%h %an %s' -3 62628c0; git show --stat --format= 62628c0 | head
